# HEKAT × JEV — copy to .env and fill in to go live.
# Everything runs offline (mock agents + local classifier + in-process tape) until set.

# --- OpenRouter (RUN agents for real) -----------------------------------------
# Presence of the key flips /api/run from mock outputs to live LLM calls.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini      # any OpenRouter model slug
# OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions

# --- TypeSafe System One (classify via the real jev-1.13.0 model) -------------
TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-1.13.0
# TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone

# --- Temporal durable execution (tree of JEV workers via jev-tape) ------------
TEMPORAL_ADDRESS=
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=hekat-jev
# JEV_TAPE_PATH=/path/to/manutej/jev-tape
