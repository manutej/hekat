# HEKAT × JEV integration — copy to .env and fill in to go live.
# Everything runs offline (local classifier + in-process tape) until these are set.

# --- TypeSafe System One (node classification via the real jev-1.13.0 model) ---
# Presence of the key flips classification from the local bag-of-words to the API.
# Vercel/CI encrypted env only — never commit a real key.
TYPESAFE_API_KEY=
# Optional overrides (defaults shown):
# TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone
# TYPESAFE_MODEL=jev-1.13.0

# --- Temporal durable execution (tree of JEV workers via jev-tape) ---
# Presence of the address + the temporalio SDK + a jev-tape clone flips durable
# execution from the in-process tape to a real Temporal worker tree.
TEMPORAL_ADDRESS=
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=hekat-jev
# JEV_TAPE_PATH=/path/to/manutej/jev-tape
